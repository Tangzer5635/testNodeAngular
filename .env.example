# Copier ce fichier en .env (à la racine du projet).

# Mot de passe de PostgreSQL. Il doit être identique à DB_PASSWORD dans back/.env
POSTGRES_PASSWORD=changeme

# Clé de signature des jetons JWT (utilisée par le back dans Docker).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=changeme
